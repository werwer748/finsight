{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/package.json\" ] || exit 0; [ \"$(jq -r .stop_hook_active)\" = true ] && exit 0; out=$(npm run lint 2>&1 && npm run build 2>&1 && npm run test 2>&1) || { echo \"$out\" | tail -n 40 >&2; exit 2; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/bash_guard.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/tdd_guard.py\""
          }
        ]
      }
    ]
  }
}
