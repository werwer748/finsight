{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && [ -f package.json ] || exit 0; [ \"$(jq -r .stop_hook_active)\" = true ] && exit 0; out=$(npm run lint 2>&1 && npm run build 2>&1 && npm run test 2>&1) || { echo \"$out\" | tail -n 40 >&2; exit 2; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/bash_guard.py\""
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && CLAUDE_PROJECT_DIR=\"$root\" python3 \"$root/scripts/tdd_guard.py\""
          }
        ]
      }
    ]
  }
}
